# Copy to .env and fill in. .env is gitignored; never commit real keys.
# evolvekit reads secrets from the environment only -- nothing else.

# --- azure: openai.AzureOpenAI (Azure OpenAI / Azure AI Foundry) ---
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- openrouter: openai.OpenAI with base_url=https://openrouter.ai/api/v1 ---
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- claude-cli: the `claude` CLI as a subprocess ---
# No key: the CLI carries its own subscription auth. Set this only when the
# binary is not on PATH.
# CLAUDE_CLI_PATH=
#
# NEVER run two claude-cli jobs at once: the subscription's five-hour session
# window is shared, so the second does not queue -- it eats the same allowance
# and both runs hit the cap together.

# --- fake ---
# No configuration. Responses come from the config's options.responses_path.
